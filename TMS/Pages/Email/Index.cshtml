                                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Email Content</label>
                                <div class="border border-gray-300 rounded-lg overflow-hidden">
                                    <div class="bg-gray-50 px-4 py-2 border-b border-gray-200">
                                        <div class="flex items-center space-x-4">
                                            <button type="button" class="p-1 text-gray-600 hover:text-gray-800" title="Bold">
                                                <i data-lucide="bold" class="w-4 h-4"></i>
                                            </button>
                                            <button type="button" class="p-1 text-gray-600 hover:text-gray-800" title="Italic">
                                                <i data-lucide="italic" class="w-4 h-4"></i>
                                            </button>
                                            <button type="button" class="p-1 text-gray-600 hover:text-gray-800" title="Link">
                                                <i data-lucide="link" class="w-4 h-4"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <textarea id="login-content"
                                              rows="12"
                                              class="w-full px-4 py-3 border-0 focus:outline-none resize-none">Hello [username],

We noticed a login to your Taskify account.

Login Details:
• Time: [login_time]
• Date: [login_date]
• IP Address: [ip_address]
• Device: [device_info]
• Location: [location]

If this was you, no action is needed. Your account remains secure.

If you don't recognize this login, please:
1. Change your password immediately: [change_password_url]
2. Contact our security team: [security_email]
3. Review your account activity

Best regards,
The Taskify Security Team</textarea>
                                </div>
                            </div>
                            <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                                <div class="flex items-center space-x-4">
                                    <button type="button" onclick="previewEmail('login')" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                                        <i data-lucide="eye" class="w-4 h-4 inline mr-2"></i>
                                        Preview
                                    </button>
                                    <button type="button" onclick="testEmail('login')" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                                        <i data-lucide="send" class="w-4 h-4 inline mr-2"></i>
                                        Send Test
                                    </button>
                                </div>
                                <div class="flex items-center space-x-4">
                                    <button type="button" onclick="resetEmailTemplate('login')" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                                        <i data-lucide="rotate-ccw" class="w-4 h-4 inline mr-2"></i>
                                        Reset
                                    </button>
                                    <button type="button" onclick="saveEmailTemplate('login')" class="btn-primary px-6 py-2">
                                        <i data-lucide="save" class="w-4 h-4 inline mr-2"></i>
                                        Save Template
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Shortcodes Sidebar for Login -->
                        <div class="lg:col-span-1">
                            <div class="bg-gray-50 rounded-lg p-4 sticky top-4">
                                <h4 class="font-semibold text-gray-800 mb-4 flex items-center">
                                    <i data-lucide="code" class="w-4 h-4 mr-2"></i>
                                    Login Shortcodes
                                </h4>
                                <div class="space-y-3">
                                    <div class="shortcode-group">
                                        <h5 class="text-sm font-medium text-gray-700 mb-2">User Information</h5>
                                        <div class="space-y-1">
                                            <button onclick="insertShortcode('login-content', '[username]')" class="shortcode-btn">
                                                <code>[username]</code>
                                                <span>User's name</span>
                                            </button>
                                            <button onclick="insertShortcode('login-content', '[email]')" class="shortcode-btn">
                                                <code>[email]</code>
                                                <span>User's email</span>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="shortcode-group">
                                        <h5 class="text-sm font-medium text-gray-700 mb-2">Login Details</h5>
                                        <div class="space-y-1">
                                            <button onclick="insertShortcode('login-content', '[login_time]')" class="shortcode-btn">
                                                <code>[login_time]</code>
                                                <span>Login time</span>
                                            </button>
                                            <button onclick="insertShortcode('login-content', '[login_date]')" class="shortcode-btn">
                                                <code>[login_date]</code>
