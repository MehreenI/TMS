@page
@model TMS.Pages.Email.IndexModel
<div id="email-templates-view" class="content-view">
    <div class="slide-in">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-800 mb-2">Email Templates</h1>
            <p class="text-gray-600">Manage and customize email templates for different system notifications</p>
        </div>

        <!-- Email Template Tabs -->
        <div class="content-card overflow-hidden">
            <!-- Tab Headers -->
            <div class="border-b border-gray-200">
                <nav class="flex space-x-8 px-6 pt-6" aria-label="Email Templates">
                    <button onclick="switchEmailTab('registration')" id="tab-registration" class="email-tab active whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm">
                        <i data-lucide="user-plus" class="w-4 h-4 inline mr-2"></i>
                        Registration Email
                    </button>
                    <button onclick="switchEmailTab('login')" id="tab-login" class="email-tab whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm">
                        <i data-lucide="log-in" class="w-4 h-4 inline mr-2"></i>
                        Login Email
                    </button>
                    <button onclick="switchEmailTab('project-assign')" id="tab-project-assign" class="email-tab whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm">
                        <i data-lucide="folder-plus" class="w-4 h-4 inline mr-2"></i>
                        Project Assign Email
                    </button>
                    <button onclick="switchEmailTab('forgot-password')" id="tab-forgot-password" class="email-tab whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm">
                        <i data-lucide="key" class="w-4 h-4 inline mr-2"></i>
                        Forgot Password Email
                    </button>
                </nav>
            </div>

            <!-- Tab Content -->
            <div class="p-6">
                <!-- Registration Email Tab -->
                <div id="email-content-registration" class="email-tab-content">
                    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                        <!-- Email Editor -->
                        <div class="lg:col-span-3 space-y-6">
                            <!-- Subject Line -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Subject Line</label>
                                <input type="text"
                                       id="registration-subject"
                                       value="Welcome to Taskify - Your Account is Ready!"
                                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500"
                                       placeholder="Enter email subject" />
                            </div>

                            <!-- Email Content Editor -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Email Content</label>
                                <div class="border border-gray-300 rounded-lg overflow-hidden">
                                    <!-- Editor Toolbar -->
                                    <div class="bg-gray-50 px-4 py-2 border-b border-gray-200">
                                        <div class="flex items-center space-x-4">
                                            <button type="button" class="p-1 text-gray-600 hover:text-gray-800" title="Bold">
                                                <i data-lucide="bold" class="w-4 h-4"></i>
                                            </button>
                                            <button type="button" class="p-1 text-gray-600 hover:text-gray-800" title="Italic">
                                                <i data-lucide="italic" class="w-4 h-4"></i>
                                            </button>
                                            <button type="button" class="p-1 text-gray-600 hover:text-gray-800" title="Underline">
                                                <i data-lucide="underline" class="w-4 h-4"></i>
                                            </button>
                                            <div class="h-4 w-px bg-gray-300"></div>
                                            <button type="button" class="p-1 text-gray-600 hover:text-gray-800" title="Link">
                                                <i data-lucide="link" class="w-4 h-4"></i>
                                            </button>
                                            <button type="button" class="p-1 text-gray-600 hover:text-gray-800" title="Image">
                                                <i data-lucide="image" class="w-4 h-4"></i>
                                            </button>
                                            <div class="h-4 w-px bg-gray-300"></div>
                                            <button type="button" class="p-1 text-gray-600 hover:text-gray-800" title="Bulleted List">
                                                <i data-lucide="list" class="w-4 h-4"></i>
                                            </button>
                                            <button type="button" class="p-1 text-gray-600 hover:text-gray-800" title="Numbered List">
                                                <i data-lucide="list-ordered" class="w-4 h-4"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <!-- Editor Content -->
                                    <textarea id="registration-content"
                                              rows="12"
                                              class="w-full px-4 py-3 border-0 focus:outline-none resize-none"
                                              placeholder="Enter your email content here...">Dear [username],

Welcome to Taskify! We're excited to have you join our team.

Your account has been successfully created with the following details:
• Email: [email]
• Login URL: [login_url]
• Temporary Password: [temp_password]

To get started:
1. Click the login link above
2. Use your email and temporary password to sign in
3. You'll be prompted to create a new secure password
4. Complete your profile setup

If you have any questions or need assistance, please don't hesitate to contact our support team at [support_email].

Best regards,
The Taskify Team
[company_name]</textarea>
                                </div>
                            </div>

                            <!-- Email Actions -->
                            <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                                <div class="flex items-center space-x-4">
                                    <button type="button" onclick="previewEmail('registration')" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                                        <i data-lucide="eye" class="w-4 h-4 inline mr-2"></i>
                                        Preview
                                    </button>
                                    <button type="button" onclick="testEmail('registration')" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                                        <i data-lucide="send" class="w-4 h-4 inline mr-2"></i>
                                        Send Test
                                    </button>
                                </div>
                                <div class="flex items-center space-x-4">
                                    <button type="button" onclick="resetEmailTemplate('registration')" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                                        <i data-lucide="rotate-ccw" class="w-4 h-4 inline mr-2"></i>
                                        Reset
                                    </button>
                                    <button type="button" onclick="saveEmailTemplate('registration')" class="btn-primary px-6 py-2">
                                        <i data-lucide="save" class="w-4 h-4 inline mr-2"></i>
                                        Save Template
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Shortcodes Sidebar -->
                        <div class="lg:col-span-1">
                            <div class="bg-gray-50 rounded-lg p-4 sticky top-4">
                                <h4 class="font-semibold text-gray-800 mb-4 flex items-center">
                                    <i data-lucide="code" class="w-4 h-4 mr-2"></i>
                                    Available Shortcodes
                                </h4>
                                <div class="space-y-3">
                                    <div class="shortcode-group">
                                        <h5 class="text-sm font-medium text-gray-700 mb-2">User Information</h5>
                                        <div class="space-y-1">
                                            <button onclick="insertShortcode('registration-content', '[username]')" class="shortcode-btn">
                                                <code>[username]</code>
                                                <span>User's name</span>
                                            </button>
                                            <button onclick="insertShortcode('registration-content', '[email]')" class="shortcode-btn">
                                                <code>[email]</code>
                                                <span>User's email</span>
                                            </button>
                                            <button onclick="insertShortcode('registration-content', '[first_name]')" class="shortcode-btn">
                                                <code>[first_name]</code>
                                                <span>First name</span>
                                            </button>
                                            <button onclick="insertShortcode('registration-content', '[last_name]')" class="shortcode-btn">
                                                <code>[last_name]</code>
                                                <span>Last name</span>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="shortcode-group">
                                        <h5 class="text-sm font-medium text-gray-700 mb-2">Login Credentials</h5>
                                        <div class="space-y-1">
                                            <button onclick="insertShortcode('registration-content', '[temp_password]')" class="shortcode-btn">
                                                <code>[temp_password]</code>
                                                <span>Temporary password</span>
                                            </button>
                                            <button onclick="insertShortcode('registration-content', '[login_url]')" class="shortcode-btn">
                                                <code>[login_url]</code>
                                                <span>Login page URL</span>
                                            </button>
                                            <button onclick="insertShortcode('registration-content', '[activation_link]')" class="shortcode-btn">
                                                <code>[activation_link]</code>
                                                <span>Account activation</span>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="shortcode-group">
                                        <h5 class="text-sm font-medium text-gray-700 mb-2">Company Information</h5>
                                        <div class="space-y-1">
                                            <button onclick="insertShortcode('registration-content', '[company_name]')" class="shortcode-btn">
                                                <code>[company_name]</code>
                                                <span>Company name</span>
                                            </button>
                                            <button onclick="insertShortcode('registration-content', '[support_email]')" class="shortcode-btn">
                                                <code>[support_email]</code>
                                                <span>Support email</span>
                                            </button>
                                            <button onclick="insertShortcode('registration-content', '[website_url]')" class="shortcode-btn">
                                                <code>[website_url]</code>
                                                <span>Website URL</span>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="shortcode-group">
                                        <h5 class="text-sm font-medium text-gray-700 mb-2">Date & Time</h5>
                                        <div class="space-y-1">
                                            <button onclick="insertShortcode('registration-content', '[current_date]')" class="shortcode-btn">
                                                <code>[current_date]</code>
                                                <span>Current date</span>
                                            </button>
                                            <button onclick="insertShortcode('registration-content', '[current_time]')" class="shortcode-btn">
                                                <code>[current_time]</code>
                                                <span>Current time</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-6 p-3 bg-blue-50 rounded-lg">
                                    <p class="text-xs text-blue-800">
                                        <i data-lucide="info" class="w-3 h-3 inline mr-1"></i>
                                        Click any shortcode to insert it at your cursor position in the editor.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Login Email Tab -->
                <div id="email-content-login" class="email-tab-content hidden">
                    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                        <!-- Email Editor -->
                        <div class="lg:col-span-3 space-y-6">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Subject Line</label>
                                <input type="text"
                                       id="login-subject"
