                                <div class="border border-gray-300 rounded-lg overflow-hidden">
                                    <div class="bg-gray-50 px-4 py-2 border-b border-gray-200">
                                        <div class="flex items-center space-x-4">
                                            <button type="button" class="p-1 text-gray-600 hover:text-gray-800" title="Bold">
                                                <i data-lucide="bold" class="w-4 h-4"></i>
                                            </button>
                                            <button type="button" class="p-1 text-gray-600 hover:text-gray-800" title="Italic">
                                                <i data-lucide="italic" class="w-4 h-4"></i>
                                            </button>
                                            <button type="button" class="p-1 text-gray-600 hover:text-gray-800" title="Link">
                                                <i data-lucide="link" class="w-4 h-4"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <textarea id="forgot-password-content"
                                              rows="12"
                                              class="w-full px-4 py-3 border-0 focus:outline-none resize-none">Hello [username],

We received a request to reset your Taskify account password.

If you made this request, click the button below to reset your password:

[reset_password_button]

Or copy and paste this link into your browser:
[reset_password_url]

This password reset link will expire in [expiry_time] hours for security reasons.

Password Reset Details:
• Request Time: [request_time]
• IP Address: [ip_address]
• Device: [device_info]

If you didn't request a password reset, please ignore this email. Your password will remain unchanged.

For additional security:
• Never share your password with anyone
• Use a strong, unique password
• Contact support if you notice suspicious activity: [support_email]

Best regards,
The Taskify Security Team</textarea>
                                </div>
                            </div>
                            <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                                <div class="flex items-center space-x-4">
                                    <button type="button" onclick="previewEmail('forgot-password')" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                                        <i data-lucide="eye" class="w-4 h-4 inline mr-2"></i>
                                        Preview
                                    </button>
                                    <button type="button" onclick="testEmail('forgot-password')" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                                        <i data-lucide="send" class="w-4 h-4 inline mr-2"></i>
                                        Send Test
                                    </button>
                                </div>
                                <div class="flex items-center space-x-4">
                                    <button type="button" onclick="resetEmailTemplate('forgot-password')" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                                        <i data-lucide="rotate-ccw" class="w-4 h-4 inline mr-2"></i>
                                        Reset
                                    </button>
                                    <button type="button" onclick="saveEmailTemplate('forgot-password')" class="btn-primary px-6 py-2">
                                        <i data-lucide="save" class="w-4 h-4 inline mr-2"></i>
                                        Save Template
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Shortcodes Sidebar for Forgot Password -->
                        <div class="lg:col-span-1">
                            <div class="bg-gray-50 rounded-lg p-4 sticky top-4">
                                <h4 class="font-semibold text-gray-800 mb-4 flex items-center">
                                    <i data-lucide="code" class="w-4 h-4 mr-2"></i>
                                    Password Reset Shortcodes
                                </h4>
                                <div class="space-y-3">
                                    <div class="shortcode-group">
                                        <h5 class="text-sm font-medium text-gray-700 mb-2">User Information</h5>
                                        <div class="space-y-1">
                                            <button onclick="insertShortcode('forgot-password-content', '[username]')" class="shortcode-btn">
                                                <code>[username]</code>
                                                <span>User's name</span>
                                            </button>
                                            <button onclick="insertShortcode('forgot-password-content', '[email]')" class="shortcode-btn">
                                                <code>[email]</code>
                                                <span>User's email</span>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="shortcode-group">
                                        <h5 class="text-sm font-medium text-gray-700 mb-2">Reset Links</h5>
                                        <div class="space-y-1">
                                            <button onclick="insertShortcode('forgot-password-content', '[reset_password_url]')" class="shortcode-btn">
                                                <code>[reset_password_url]</code>
                                                <span>Reset URL</span>
                                            </button>
                                            <button onclick="insertShortcode('forgot-password-content', '[reset_password_button]')" class="shortcode-btn">
                                                <code>[reset_password_button]</code>
                                                <span>Reset button</span>
                                            </button>
                                            <button onclick="insertShortcode('forgot-password-content', '[expiry_time]')" class="shortcode-btn">
                                                <code>[expiry_time]</code>
                                                <span>Link expiry hours</span>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="shortcode-group">
                                        <h5 class="text-sm font-medium text-gray-700 mb-2">Request Details</h5>
                                        <div class="space-y-1">
                                            <button onclick="insertShortcode('forgot-password-content', '[request_time]')" class="shortcode-btn">
                                                <code>[request_time]</code>
                                                <span>Request time</span>
                                            </button>
                                            <button onclick="insertShortcode('forgot-password-content', '[ip_address]')" class="shortcode-btn">
                                                <code>[ip_address]</code>
                                                <span>IP address</span>
                                            </button>
                                            <button onclick="insertShortcode('forgot-password-content', '[device_info]')" class="shortcode-btn">
                                                <code>[device_info]</code>
                                                <span>Device info</span>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="shortcode-group">
                                        <h5 class="text-sm font-medium text-gray-700 mb-2">Support</h5>
                                        <div class="space-y-1">
                                            <button onclick="insertShortcode('forgot-password-content', '[support_email]')" class="shortcode-btn">
                                                <code>[support_email]</code>
                                                <span>Support email</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hidden form for posting template updates -->
    <form id="emailTemplateForm" method="post" asp-page-handler="SaveTemplate" class="hidden">
        <input type="hidden" name="templateId" id="templateId" />
        <input type="hidden" name="subject" id="templateSubject" />
        <input type="hidden" name="content" id="templateContent" />
        @Html.AntiForgeryToken()
    </form>
</div>

<script>
    lucide.createIcons();

    function saveEmailTemplate(tab) {
        const subjectInput = document.getElementById(`${tab}-subject`);
        const contentInput = document.getElementById(`${tab}-content`);
        const form = document.getElementById('emailTemplateForm');
        document.getElementById('templateId').value = tab;
        document.getElementById('templateSubject').value = subjectInput ? subjectInput.value : '';
        document.getElementById('templateContent').value = contentInput ? contentInput.value : '';
        form.submit();
    }

    function previewEmail(tab) {
        alert('Preview not implemented in web app. Save the template and use backend preview if available.');
    }

    function testEmail(tab) {
        alert('Test email requires a backend endpoint. Add it to the API to enable this button.');
    }

    function resetEmailTemplate(tab) {
        const defaults = {
            'registration': { subject: 'Welcome to Taskify - Your Account is Ready!', contentId: 'registration-content' },
            'login': { subject: 'Login Notification - Taskify Account Access', contentId: 'login-content' },
            'project-assign': { subject: 'New Project Assignment: [project_name]', contentId: 'project-assign-content' },
            'forgot-password': { subject: 'Reset Your Taskify Password', contentId: 'forgot-password-content' }
        };
        const config = defaults[tab];
        if (!config) return;
        const subjectEl = document.getElementById(`${tab}-subject`);
        const contentEl = document.getElementById(config.contentId);
        if (subjectEl) subjectEl.value = config.subject;
        if (contentEl) contentEl.value = contentEl.defaultValue;
    }

    function switchEmailTab(tab) {
        document.querySelectorAll('.email-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.email-tab-content').forEach(c => c.classList.add('hidden'));
        const activeTab = document.getElementById(`tab-${tab}`);
        const activeContent = document.getElementById(`email-content-${tab}`);
        if (activeTab) activeTab.classList.add('active');
        if (activeContent) activeContent.classList.remove('hidden');
    }

    function insertShortcode(textareaId, shortcode) {
        const textarea = document.getElementById(textareaId);
        if (!textarea) return;
        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        const value = textarea.value;
        textarea.value = value.substring(0, start) + shortcode + value.substring(end);
        textarea.focus();
        textarea.selectionStart = textarea.selectionEnd = start + shortcode.length;
    }
</script>
