                                                <code>[device_info]</code>
                                                <span>Device info</span>
                                            </button>
                                            <button onclick="insertShortcode('login-content', '[location]')" class="shortcode-btn">
                                                <code>[location]</code>
                                                <span>Login location</span>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="shortcode-group">
                                        <h5 class="text-sm font-medium text-gray-700 mb-2">Security Links</h5>
                                        <div class="space-y-1">
                                            <button onclick="insertShortcode('login-content', '[change_password_url]')" class="shortcode-btn">
                                                <code>[change_password_url]</code>
                                                <span>Password change</span>
                                            </button>
                                            <button onclick="insertShortcode('login-content', '[security_email]')" class="shortcode-btn">
