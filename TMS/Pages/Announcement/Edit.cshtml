@page "{id}"
@model TMS.Pages.Announcement.EditModel
@{
	ViewData["Title"] = "Edit Announcement";
}

<div class="max-w-2xl mx-auto space-y-6">
	<h1 class="text-2xl font-bold text-gray-800">Edit Announcement</h1>

	@if (TempData["ErrorMessage"] != null)
	{
		<div class="p-3 bg-red-50 border border-red-200 rounded text-red-800">@TempData["ErrorMessage"]</div>
	}

	<form method="post" asp-antiforgery="true" class="bg-white p-6 rounded-xl border border-gray-200 space-y-4">
		<div>
			<label class="block text-sm font-medium text-gray-700 mb-2">Title</label>
			<input asp-for="Announcement.Title" class="w-full px-4 py-2 border border-gray-300 rounded" />
			<span asp-validation-for="Announcement.Title" class="text-sm text-red-600"></span>
		</div>
		<div>
			<label class="block text-sm font-medium text-gray-700 mb-2">Content</label>
			<textarea asp-for="Announcement.Content" rows="6" class="w-full px-4 py-2 border border-gray-300 rounded"></textarea>
			<span asp-validation-for="Announcement.Content" class="text-sm text-red-600"></span>
		</div>
		<div class="flex items-center space-x-3">
			<a asp-page="/Announcement/Index" class="px-4 py-2 border border-gray-300 rounded">Cancel</a>
			<button type="submit" class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700">Save Changes</button>
		</div>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
