@page
@model TMS.Pages.Announcement.IndexModel
@{
	ViewData["Title"] = "Announcements";
}

<div class="space-y-6">
	<div class="flex items-center justify-between">
		<h1 class="text-2xl font-bold text-gray-800">Announcements</h1>
		@if (Model.IsAdmin)
		{
			<a asp-page="/Announcement/Create" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
				<i data-lucide="plus" class="w-4 h-4 inline mr-2"></i>
				New Announcement
			</a>
		}
	</div>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="p-3 bg-green-50 border border-green-200 rounded text-green-800">@TempData["SuccessMessage"]</div>
	}
	@if (TempData["ErrorMessage"] != null)
	{
		<div class="p-3 bg-red-50 border border-red-200 rounded text-red-800">@TempData["ErrorMessage"]</div>
	}

	<div class="bg-white rounded-xl shadow-sm border border-gray-200">
		<div class="divide-y">
			@if (Model.Announcements == null || !Model.Announcements.Any())
			{
				<div class="p-6 text-gray-600">No announcements yet.</div>
			}
			else
			{
				@foreach (var ann in Model.Announcements)
				{
					<div class="p-6 flex items-start justify-between">
						<div>
							<h3 class="font-semibold text-gray-800">@ann.Title</h3>
							<p class="text-sm text-gray-600 mt-1">@ann.Content</p>
							<p class="text-xs text-gray-500 mt-2">Posted @ann.CreatedAt.ToString("MMM dd, yyyy")</p>
						</div>
						<div class="flex items-center space-x-2">
							<a asp-page="/Announcement/Edit" asp-route-id="@ann.Id" class="text-blue-600 hover:text-blue-700">
								<i data-lucide="edit" class="w-4 h-4"></i>
							</a>
							@if (Model.IsAdmin)
							{
								<form method="post" asp-page-handler="Delete" asp-route-id="@ann.Id" onsubmit="return confirm('Delete this announcement?');">
									<button type="submit" class="text-red-600 hover:text-red-700">
										<i data-lucide="trash-2" class="w-4 h-4"></i>
									</button>
								</form>
							}
						</div>
					</div>
				}
			}
		</div>
	</div>
</div>

<script>
	lucide.createIcons();
</script>
