@page
@model TMS.Pages.Home.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Login - Task Management System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
</head>
<body class="min-h-screen bg-black flex">
    <!-- Left Side - Branding Section -->
    <div class="hidden lg:flex lg:w-2/5 bg-gradient-to-br from-red-600 via-red-700 to-red-800 relative overflow-hidden">
        <!-- Geometric Pattern -->
        <div class="absolute inset-0 opacity-10">
            <div class="absolute top-1/4 left-1/4 w-16 h-16 border border-white transform rotate-45"></div>
            <div class="absolute top-1/3 right-1/4 w-12 h-12 border border-white transform rotate-12"></div>
            <div class="absolute bottom-1/4 left-1/3 w-8 h-8 border border-white transform -rotate-45"></div>
            <div class="absolute bottom-1/3 right-1/3 w-10 h-10 border border-white transform rotate-45"></div>
        </div>

        <!-- Content -->
        <div class="relative z-10 flex flex-col justify-center px-8 text-white">
            <div class="mb-6">
                <div class="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-xl flex items-center justify-center mb-4 border border-white/30">
                    <i data-lucide="clipboard-check" class="w-6 h-6 text-white"></i>
                </div>
                <h1 class="text-2xl font-bold mb-2 leading-tight">
                    Task Management
                    <span class="block text-red-200">System</span>
                </h1>
                <p class="text-sm text-red-100 mb-6">
                    Streamline workflows with our powerful task management platform.
                </p>
            </div>

            <!-- Features -->
            <div class="space-y-3">
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center">
                        <i data-lucide="shield-check" class="w-4 h-4 text-white"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-sm">Enterprise Security</h3>
                        <p class="text-red-100 text-xs">Bank-level encryption</p>
                    </div>
                </div>
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center">
                        <i data-lucide="zap" class="w-4 h-4 text-white"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-sm">Lightning Fast</h3>
                        <p class="text-red-100 text-xs">Optimized performance</p>
                    </div>
                </div>
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center">
                        <i data-lucide="users" class="w-4 h-4 text-white"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-sm">Team Collaboration</h3>
                        <p class="text-red-100 text-xs">Real-time tools</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side - Login Form -->
    <div class="w-full lg:w-3/5 bg-white flex items-center justify-center p-4 sm:p-6 lg:p-8">
        <div class="w-full max-w-sm">
            <!-- Mobile Logo -->
            <div class="lg:hidden text-center mb-6">
                <div class="w-12 h-12 bg-gradient-to-r from-red-600 to-red-700 rounded-xl flex items-center justify-center mx-auto mb-3">
                    <i data-lucide="clipboard-check" class="w-6 h-6 text-white"></i>
                </div>
                <h1 class="text-lg font-bold text-gray-900">Task Management System</h1>
            </div>

            <!-- Login Header -->
            <div class="mb-6">
                <h2 class="text-2xl font-bold text-gray-900 mb-2">Welcome Back</h2>
                <p class="text-gray-600 text-sm">Sign in to your account</p>
            </div>

            <!-- Error Messages -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="mb-4 p-3 bg-red-50 border-l-4 border-red-500 rounded-r-lg">
                    <div class="flex items-center space-x-2">
                        <i data-lucide="alert-circle" class="w-4 h-4 text-red-600"></i>
                        <span class="text-red-700 text-sm">@Model.ErrorMessage</span>
                    </div>
                </div>
            }

            <!-- Login Form -->
            <form method="post" class="space-y-4">
                <!-- Email Field -->
                <div>
                    <label asp-for="Input.Email" class="block text-sm font-medium text-gray-900 mb-2">
                        Email Address
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-lucide="mail" class="w-4 h-4 text-gray-400"></i>
                        </div>
                        <input asp-for="Input.Email"
                               type="email"
                               class="w-full pl-10 pr-3 py-2.5 border-2 border-gray-200 rounded-lg text-gray-900 placeholder-gray-500 focus:outline-none focus:border-red-600 transition-colors duration-200"
                               placeholder="Enter your email"
                               required />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-red-600 text-xs mt-1 block"></span>
                </div>

                <!-- Password Field -->
                <div>
                    <label asp-for="Input.Password" class="block text-sm font-medium text-gray-900 mb-2">
                        Password
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-lucide="lock" class="w-4 h-4 text-gray-400"></i>
                        </div>
                        <input asp-for="Input.Password"
                               type="password"
                               id="password"
                               class="w-full pl-10 pr-10 py-2.5 border-2 border-gray-200 rounded-lg text-gray-900 placeholder-gray-500 focus:outline-none focus:border-red-600 transition-colors duration-200"
                               placeholder="Enter your password"
                               required />
                        <button type="button"
                                onclick="togglePassword()"
                                class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600">
                            <i data-lucide="eye" id="eyeIcon" class="w-4 h-4"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-red-600 text-xs mt-1 block"></span>
                </div>

                <!-- Remember Me & Forgot Password -->
                <div class="flex items-center justify-between">
                    <label class="flex items-center cursor-pointer">
                        <input type="checkbox" class="w-3.5 h-3.5 rounded border-gray-300 text-red-600 focus:ring-red-600">
                        <span class="ml-2 text-sm text-gray-700">Remember me</span>
                    </label>
                    <a href="#" class="text-sm font-medium text-red-600 hover:text-red-700">
                        Forgot password?
                    </a>
                </div>

                <!-- Login Button -->
                <button type="submit"
                        class="w-full py-2.5 px-4 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg shadow-md transform transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-red-600/25">
                    <i data-lucide="arrow-right" class="w-4 h-4 inline mr-2"></i>
                    Sign In
                </button>
            </form>

            <!-- Footer -->
            <div class="mt-6 text-center">
                <p class="text-gray-600 text-sm">
                    Don't have an account?
                    <a href="#" class="font-medium text-red-600 hover:text-red-700">Contact Admin</a>
                </p>
            </div>

        </div>
    </div>

    <!-- Scripts -->
    <script>
        // Initialize Lucide icons
        lucide.createIcons();

        // Toggle password visibility
        function togglePassword() {
            const passwordField = document.getElementById('password');
            const eyeIcon = document.getElementById('eyeIcon');

            if (passwordField.type === 'password') {
                passwordField.type = 'text';
                eyeIcon.setAttribute('data-lucide', 'eye-off');
            } else {
                passwordField.type = 'password';
                eyeIcon.setAttribute('data-lucide', 'eye');
            }

            lucide.createIcons();
        }

        // Form submission loading state
        const loginForm = document.querySelector('form');
        const submitButton = document.querySelector('button[type="submit"]');

        if (loginForm && submitButton) {
            loginForm.addEventListener('submit', function() {
                submitButton.disabled = true;
                submitButton.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 inline mr-2 animate-spin"></i>Signing In...';
                submitButton.classList.add('bg-red-700');
                lucide.createIcons();

                setTimeout(() => {
                    if (submitButton.disabled) {
                        submitButton.disabled = false;
                        submitButton.innerHTML = '<i data-lucide="arrow-right" class="w-4 h-4 inline mr-2"></i>Sign In';
                        submitButton.classList.remove('bg-red-700');
                        lucide.createIcons();
                    }
                }, 3000);
            });
        }

        // Enhanced input focus effects
        const inputs = document.querySelectorAll('input[type="email"], input[type="password"]');
        inputs.forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.classList.add('ring-2', 'ring-red-600/20');
            });

            input.addEventListener('blur', function() {
                this.parentElement.classList.remove('ring-2', 'ring-red-600/20');
            });
        });

        // Auto-hide success messages
        setTimeout(function() {
            const successMessage = document.querySelector('.bg-green-50');
            if (successMessage) {
                successMessage.style.transition = 'opacity 0.5s ease';
                successMessage.style.opacity = '0';
                setTimeout(() => successMessage.remove(), 500);
            }
        }, 3000);
    </script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>