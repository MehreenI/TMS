@page
@model TMS.Pages.Home.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Login - Task Management System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

   
</head>
<body class="min-h-screen flex items-center justify-center relative">
    <!-- Background shapes -->
    <div class="floating-shapes">
        <div class="shape w-16 h-16 bg-white rounded-full"></div>
        <div class="shape w-24 h-24 bg-white rounded-lg"></div>
        <div class="shape w-20 h-20 bg-white rounded-full"></div>
        <div class="shape w-12 h-12 bg-white rounded-lg"></div>
    </div>

    <div class="login-card w-full max-w-md mx-4 p-8 rounded-2xl shadow-2xl slide-in relative z-10">
        <!-- Logo and Header -->
        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-gradient-to-r from-red-600 to-red-700 rounded-xl flex items-center justify-center mx-auto mb-4">
                <i data-lucide="clipboard-check" class="w-8 h-8 text-white"></i>
            </div>
            <h1 class="text-3xl font-bold text-gray-800 mb-2">Welcome Back</h1>
            <p class="text-gray-600">Sign in to your Task Management System</p>
        </div>

        <!-- Error Messages -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
                <div class="flex items-center space-x-2">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-red-600"></i>
                    <span class="text-red-700 text-sm">@Model.ErrorMessage</span>
                </div>
            </div>
        }

        <!-- Login Form -->
        <form method="post" class="space-y-6">
            <!-- Email Field -->
            <div>
                <label asp-for="Input.Email" class="block text-sm font-medium text-gray-700 mb-2">
                    <i data-lucide="mail" class="w-4 h-4 inline mr-2"></i>Email Address
                </label>
                <input asp-for="Input.Email"
                       type="email"
                       class="input-field w-full px-4 py-3 bg-white border border-gray-300 rounded-xl text-gray-800 placeholder-gray-400 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-500 focus:ring-opacity-20"
                       placeholder="Enter your email address"
                       required />
                <span asp-validation-for="Input.Email" class="text-red-600 text-sm"></span>
            </div>

            <!-- Password Field -->
            <div>
                <label asp-for="Input.Password" class="block text-sm font-medium text-gray-700 mb-2">
                    <i data-lucide="lock" class="w-4 h-4 inline mr-2"></i>Password
                </label>
                <div class="relative">
                    <input asp-for="Input.Password"
                           type="password"
                           id="password"
                           class="input-field w-full px-4 py-3 bg-white border border-gray-300 rounded-xl text-gray-800 placeholder-gray-400 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-500 focus:ring-opacity-20"
                           placeholder="Enter your password"
                           required />
                    <button type="button"
                            onclick="togglePassword()"
                            class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600">
                        <i data-lucide="eye" id="eyeIcon" class="w-5 h-5"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-red-600 text-sm"></span>
            </div>

            <!-- Remember Me & Forgot Password -->
            <div class="flex items-center justify-between">
                <label class="flex items-center">
                    <input type="checkbox" class="rounded border-gray-300 text-red-600 focus:border-red-300 focus:ring focus:ring-red-200 focus:ring-opacity-50">
                    <span class="ml-2 text-sm text-gray-600">Remember me</span>
                </label>
                <a href="#" class="text-sm text-red-600 hover:text-red-500 font-medium">
                    Forgot password?
                </a>
            </div>

            <!-- Login Button -->
            <button type="submit"
                    class="btn-primary w-full py-3 px-4 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-xl shadow-lg">
                <i data-lucide="log-in" class="w-5 h-5 inline mr-2"></i>
                Sign In
            </button>
        </form>

        <!-- Footer -->
        <div class="mt-8 text-center">
            <p class="text-gray-600 text-sm">
                Don't have an account?
                <a href="#" class="text-red-600 hover:text-red-500 font-medium">Contact Administrator</a>
            </p>
        </div>

        <!-- Demo Credentials (Remove in production) -->
        <div class="mt-6 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
            <h4 class="text-sm font-medium text-yellow-800 mb-2">Demo Credentials:</h4>
            <p class="text-xs text-yellow-700">Email: admin@example.com</p>
            <p class="text-xs text-yellow-700">Password: admin123</p>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        // Initialize Lucide icons
        lucide.createIcons();

        // Toggle password visibility
        function togglePassword() {
            const passwordField = document.getElementById('password');
            const eyeIcon = document.getElementById('eyeIcon');

            if (passwordField.type === 'password') {
                passwordField.type = 'text';
                eyeIcon.setAttribute('data-lucide', 'eye-off');
            } else {
                passwordField.type = 'password';
                eyeIcon.setAttribute('data-lucide', 'eye');
            }

            // Recreate the icon
            lucide.createIcons();
        }

        // Auto-hide success message
        setTimeout(function() {
            const successMessage = document.querySelector('.bg-green-50');
            if (successMessage) {
                successMessage.style.transition = 'opacity 0.5s ease';
                successMessage.style.opacity = '0';
                setTimeout(() => successMessage.remove(), 500);
            }
        }, 3000);

        // Add loading state to form submission
        const loginForm = document.querySelector('form');
        const submitButton = document.querySelector('button[type="submit"]');

        loginForm.addEventListener('submit', function() {
            submitButton.disabled = true;
            submitButton.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 inline mr-2 animate-spin"></i>Signing In...';
            lucide.createIcons();
        });
    </script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>