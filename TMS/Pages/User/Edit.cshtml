@page
@model TMS.Pages.User.EditModel
@{
    ViewData["Title"] = "Edit User";
}
<div id="edit-user-view" class="content-view">
    <div class="slide-in">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Edit User</h1>
            <a asp-page="./Index" class="px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-50 transition-colors">
                <i data-lucide="arrow-left" class="w-4 h-4 inline mr-2"></i>
                Back to Users
            </a>
        </div>

        <div class="content-card p-6">
            <form method="post" asp-antiforgery="true">
                <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4"></div>
                <input type="hidden" asp-for="UserModel.Id" />
                
                <div class="space-y-6">
                    <!-- Basic Information -->
                    <div>
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Basic Information</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-gray-700 text-sm font-medium mb-2">First Name *</label>
                                <input asp-for="UserModel.FirstName" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200">
                                <span asp-validation-for="UserModel.FirstName" class="text-red-600 text-sm"></span>
                            </div>
                            <div>
                                <label class="block text-gray-700 text-sm font-medium mb-2">Last Name *</label>
                                <input asp-for="UserModel.LastName" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200">
                                <span asp-validation-for="UserModel.LastName" class="text-red-600 text-sm"></span>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="block text-gray-700 text-sm font-medium mb-2">Email Address *</label>
                        <input asp-for="UserModel.Email" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200">
                        <span asp-validation-for="UserModel.Email" class="text-red-600 text-sm"></span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2">Phone Number</label>
                            <input asp-for="UserModel.PhoneNumber" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200">
                            <span asp-validation-for="UserModel.PhoneNumber" class="text-red-600 text-sm"></span>
                        </div>
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2">Role</label>
                            <select asp-for="UserModel.Role" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200">
                                <option value="User">User</option>
                                <option value="Admin">Admin</option>
                            </select>
                            <span asp-validation-for="UserModel.Role" class="text-red-600 text-sm"></span>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="border-t border-gray-200 pt-6">
                        <div class="flex space-x-4">
                            <button type="submit" class="btn-primary px-6 py-2 rounded-md">
                                <i data-lucide="save" class="w-4 h-4 inline mr-2"></i>
                                Save Changes
                            </button>
                            <a asp-page="./Index" class="px-6 py-2 border border-gray-300 rounded-md hover:bg-gray-50 transition-colors">
                                Cancel
                            </a>
                            <a asp-page="./Delete" asp-route-id="@Model.UserModel.Id" class="px-6 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 transition-colors">
                                <i data-lucide="trash-2" class="w-4 h-4 inline mr-2"></i>
                                Delete User
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
