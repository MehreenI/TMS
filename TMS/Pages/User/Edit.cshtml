@page
@model TMS.Pages.User.EditModel
<div id="edit-user-view" class="content-view">
    <div class="slide-in">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Edit User</h1>
            <a asp-page="./Index" class="px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-50 transition-colors">
                <i data-lucide="arrow-left" class="w-4 h-4 inline mr-2"></i>
                Back to Users
            </a>
        </div>

        <div class="content-card p-6">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4"></div>
                <input type="hidden" asp-for="SelectedUser.Id" />
                <div class="space-y-6">
                    <!-- Basic Information -->
                    <div>
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Basic Information</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label asp-for="SelectedUser.FullName" class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                                <input asp-for="SelectedUser.FullName" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500" />
                                <span asp-validation-for="SelectedUser.FullName" class="text-red-500 text-sm"></span>
                            </div>
                            <div>
                                <label asp-for="SelectedUser.Email" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                                <input asp-for="SelectedUser.Email" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500" />
                                <span asp-validation-for="SelectedUser.Email" class="text-red-500 text-sm"></span>
                            </div>
                        </div>
                    </div>

                <!-- Work Information -->
                <div class="border-t border-gray-200 pt-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4">Work Information</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label asp-for="SelectedUser.Role" class="block text-sm font-medium text-gray-700 mb-2">Role</label>
                            <select asp-for="SelectedUser.Role" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500">
                                <option value="Admin">Admin</option>
                                <option value="Manager">Manager</option>
                                <option value="User">User</option>
                            </select>
                            <span asp-validation-for="SelectedUser.Role" class="text-red-500 text-sm"></span>
                        </div>
                        
                        <div>
                            <label asp-for="SelectedUser.ProfileImagePath" class="block text-sm font-medium text-gray-700 mb-2">Profile Image URL</label>
                            <input asp-for="SelectedUser.ProfileImagePath" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500" />
                            <span asp-validation-for="SelectedUser.ProfileImagePath" class="text-red-500 text-sm"></span>
                        </div>
                    </div>
                </div>

                <!-- Password Reset Section -->
                <div class="border-t border-gray-200 pt-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4">Password Management</h3>
                    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-4">
                        <div class="flex items-start space-x-3">
                            <i data-lucide="alert-triangle" class="w-5 h-5 text-yellow-600 mt-0.5"></i>
                            <div>
                                <h4 class="text-sm font-medium text-yellow-800">Password Reset</h4>
                                <p class="text-sm text-yellow-700 mt-1">Leave password field empty to keep current password. Enter new password to update.</p>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label asp-for="SelectedUser.Password" class="block text-sm font-medium text-gray-700 mb-2">New Password</label>
                            <input asp-for="SelectedUser.Password" type="password" placeholder="Enter new password (optional)" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500" />
                            <span asp-validation-for="SelectedUser.Password" class="text-red-500 text-sm"></span>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="border-t border-gray-200 pt-6">
                    <div class="flex space-x-4">
                        <button type="submit" class="btn-primary px-6 py-2 rounded-md">
                            <i data-lucide="save" class="w-4 h-4 inline mr-2"></i>
                            Save Changes
                        </button>
                        <a asp-page="./Index" class="px-6 py-2 border border-gray-300 rounded-md hover:bg-gray-50 transition-colors">
                            Cancel
                        </a>
                        <a asp-page="./Delete" asp-route-id="@Model.SelectedUser.Id" class="px-6 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 transition-colors">
                            <i data-lucide="trash-2" class="w-4 h-4 inline mr-2"></i>
                            Delete User
                        </a>
                    </div>
                </div>
            </div>
            </form>
        </div>
    </div>
</div>
