@page
@model TMS.Pages.User.ViewModel
@{
    ViewData["Title"] = "View User";
}
<div id="view-user-view" class="content-view">
    <div class="slide-in">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-3xl font-bold text-gray-800">User Details</h1>
            <div class="flex space-x-3">
                <a asp-page="./Edit" asp-route-id="@Model.UserModel.Id" class="btn-primary px-4 py-2">
                    <i data-lucide="edit" class="w-4 h-4 inline mr-2"></i>
                    Edit User
                </a>
                <a asp-page="./Index" class="px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-50 transition-colors">
                    <i data-lucide="arrow-left" class="w-4 h-4 inline mr-2"></i>
                    Back to Users
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- User Profile Card -->
            <div class="content-card p-6">
                <div class="text-center">
                    <div id="userAvatar" class="w-24 h-24 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full flex items-center justify-center mx-auto mb-4">
                        <span class="text-white font-bold text-2xl"> @Model.UserModel.FirstName?.FirstOrDefault()</span>
                    </div>
                    <h3 id="userName" class="text-xl font-bold text-gray-800 mb-1">@Model.UserModel?.FullName</h3>
                    <p id="userEmail" class="text-gray-600 mb-3">@Model.UserModel?.Email</p>
                    <div id="userStatus" class="inline-flex items-center space-x-2 px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-medium">
                        <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                        <span>Active</span>
                    </div>
                </div>

                <div class="mt-6 pt-6 border-t border-gray-200">
                    <h4 class="font-semibold text-gray-800 mb-3">Quick Stats</h4>
                    <div class="space-y-2">
                        <div class="flex justify-between">
                            <span class="text-gray-600">Tasks Assigned</span>
                            <span class="font-semibold text-gray-800">@Model.UserModel.TaskCount</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Role</span>
                            <span class="font-semibold text-gray-800">@Model.UserModel?.Role</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Joined Date</span>
                            <span class="font-semibold text-gray-800">@Model.UserModel.CreatedAt.ToString("dd MMMM yyyy")</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Completion Rate</span>
                            <span class="font-semibold text-green-600">84%</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- User Information -->
            <div class="lg:col-span-2 space-y-6">
                @if (Model.UserModel != null)
                {
                    <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
                        <div class="flex items-center space-x-6 mb-8">
                            <div class="w-24 h-24 bg-gradient-to-r from-red-500 to-red-600 rounded-full flex items-center justify-center">
                                <span class="text-white font-bold text-3xl">
                                    @Model.UserModel.FirstName?.FirstOrDefault()
                                </span>
                            </div>
                            <div class="flex-1">
                                <h2 class="text-2xl font-bold text-gray-800">@Model.UserModel.FirstName @Model.UserModel.LastName</h2>
                                <p class="text-gray-600">@Model.UserModel.Email</p>
                                <div class="flex items-center space-x-4 mt-2">
                                    <span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium">
                                        @Model.UserModel.Role
                                    </span>
                                   
                                        <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-medium">
                                            @Model.UserModel.TaskCount Tasks
                                        </span>
                                    
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-800 mb-4">Personal Information</h3>
                                <div class="space-y-3">
                                    <div>
                                        <span class="text-gray-500 text-sm">Full Name:</span>
                                        <p class="text-gray-800">@Model.UserModel.FirstName @Model.UserModel.LastName</p>
                                    </div>
                                    <div>
                                        <span class="text-gray-500 text-sm">Email:</span>
                                        <p class="text-gray-800">@Model.UserModel.Email</p>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.UserModel.PhoneNumber))
                                    {
                                        <div>
                                            <span class="text-gray-500 text-sm">Phone:</span>
                                            <p class="text-gray-800">@Model.UserModel.PhoneNumber</p>
                                        </div>
                                    }
                                    
                                </div>
                            </div>

                            <div>
                                <h3 class="text-lg font-semibold text-gray-800 mb-4">Account Information</h3>
                                <div class="space-y-3">
                                    <div>
                                        <span class="text-gray-500 text-sm">Role:</span>
                                        <p class="text-gray-800">@Model.UserModel.Role</p>
                                    </div>
                                    <div>
                                        <span class="text-gray-500 text-sm">User ID:</span>
                                        <p class="text-gray-800">@Model.UserModel.Id</p>
                                    </div>
                                    
                                        <div>
                                            <span class="text-gray-500 text-sm">Total Tasks:</span>
                                            <p class="text-gray-800">@Model.UserModel.TaskCount</p>
                                        </div>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                }
       </div>
        </div>
    </div>
</div>