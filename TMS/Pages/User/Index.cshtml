@page
@model TMS.Pages.User.IndexModel

<div id="all-users-view" class="content-view">
    <div class="slide-in">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h2 class="text-3xl font-bold text-gray-800 mb-2">User Management</h2>
                <p class="text-gray-600">Manage system users, roles, and permissions</p>
            </div>
            <div class="flex space-x-3">
                <button type="button" onclick="exportUserCSV()" class="px-4 py-2 bg-white hover:bg-gray-50 text-gray-700 rounded-lg transition-colors border border-gray-300">
                    <i data-lucide="download" class="w-4 h-4 inline mr-2"></i>Export
                </button>
                <a asp-page="./Create" class="btn-primary px-6 py-3 rounded-lg font-medium">
                    <i data-lucide="user-plus" class="w-5 h-5 inline mr-2"></i>Create User
                </a>
               
            </div>
        </div>


        <!-- User Statistics -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="content-card p-6 hover:transform hover:translateY(-2px) transition-all duration-300">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">Total Users</p>
                        <p class="text-2xl font-bold text-gray-800">@Model.GetTotalUsers()</p>
                    </div>
                    <div class="p-3 bg-blue-600 rounded-lg">
                        <i data-lucide="users" class="w-6 h-6 text-white"></i>
                    </div>
                </div>
            </div>

            <div class="content-card p-6 hover:transform hover:translateY(-2px) transition-all duration-300">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">Active Users</p>
                        <p class="text-2xl font-bold text-gray-800">@Model.GetActiveUsers()</p>
                    </div>
                    <div class="p-3 bg-green-600 rounded-lg">
                        <i data-lucide="user-check" class="w-6 h-6 text-white"></i>
                    </div>
                </div>
            </div>

            <div class="content-card p-6 hover:transform hover:translateY(-2px) transition-all duration-300">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">New This Month</p>
                        <p class="text-2xl font-bold text-gray-800">@Model.GetNewUsersThisMonth()</p>
                    </div>
                    <div class="p-3 bg-purple-600 rounded-lg">
                        <i data-lucide="user-plus" class="w-6 h-6 text-white"></i>
                    </div>
                </div>
            </div>

            <div class="content-card p-6 hover:transform hover:translateY(-2px) transition-all duration-300">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">Admins</p>
                        <p class="text-2xl font-bold text-gray-800">@Model.GetAdminUsers()</p>
                    </div>
                    <div class="p-3 bg-red-600 rounded-lg">
                        <i data-lucide="shield" class="w-6 h-6 text-white"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Users Table -->
        <div class="content-card overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-red-600">
                        <tr>
                            <th class="px-6 py-4 text-left text-white font-semibold">
                                #
                            </th>
                            <th class="px-6 py-4 text-left text-white font-semibold">User</th>
                            <th class="px-6 py-4 text-left text-white font-semibold">Role</th>
                            <th class="px-6 py-4 text-left text-white font-semibold">Status</th>
                            <th class="px-6 py-4 text-left text-white font-semibold">Tasks</th>
                            <th class="px-6 py-4 text-left text-white font-semibold">Joined</th>
                            <th class="px-6 py-4 text-left text-white font-semibold">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        @if (Model.Users != null && Model.Users.Any())
                        {
                            @foreach (var user in Model.Users)
                            {
                                var statusClass = user.Status switch
                                {
                                    "Active" => "bg-green-100 text-green-800",
                                    _ => "bg-gray-100 text-gray-800"
                                };

                                var roleClass = user.Role?.ToLower() switch
                                {
                                    "admin" => "bg-red-600 text-white",
                                    "manager" => "bg-blue-600 text-white",
                                    "developer" => "bg-purple-600 text-white",
                                    "designer" => "bg-pink-600 text-white",
                                    _ => "bg-green-600 text-white"
                                };

                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-6 py-4">
                                       @user.Id
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center space-x-3">
                                            @if (!string.IsNullOrEmpty(user.ProfileImagePath))
                                            {
                                                <img src="@user.ProfileImagePath" alt="@user.FullName" class="w-10 h-10 rounded-full object-cover" />
                                            }
                                            else
                                            {
                                                <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full flex items-center justify-center">
                                                    <span class="text-white font-semibold text-sm">
                                                        @(user.FirstName?.FirstOrDefault().ToString().ToUpper() ?? "U")@(user.LastName?.FirstOrDefault().ToString().ToUpper() ?? "")
                                                    </span>
                                                </div>
                                            }
                                            <div>
                                                <p class="text-gray-800 font-medium capitalize">@user.FirstName @user.LastName</p>
                                                <p class="text-gray-600 text-sm">@user.Email</p>
                                                @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                                {
                                                    <p class="text-gray-500 text-xs">@user.PhoneNumber</p>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-3 py-1 @roleClass rounded-full text-sm font-medium capitalize">@user.Role</span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-3 py-1 @statusClass rounded-full text-sm font-medium">@user.Status</span>
                                        @if (user.LastLogin.HasValue)
                                        {
                                            <p class="text-xs text-gray-500 mt-1">Last: @user.LastLogin.Value.ToString("MM/dd/yyyy")</p>
                                        }
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="text-center">
                                            <p class="text-gray-800 font-semibold">@user.TaskCount</p>
                                            <p class="text-gray-600 text-xs">Assigned</p>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-gray-700">
                                        @user.CreatedAt.ToString("MM/dd/yyyy")
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center space-x-2">
                                            <a asp-page="./View" asp-route-id="@user.Id" class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="View">
                                                <i data-lucide="eye" class="w-4 h-4"></i>
                                            </a>
                                            <a asp-page="./Edit" asp-route-id="@user.Id" class="p-2 text-green-600 hover:bg-green-50 rounded-lg transition-colors" title="Edit">
                                                <i data-lucide="edit" class="w-4 h-4"></i>
                                            </a>
                                            <a asp-page="./Delete" asp-route-id="@user.Id" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Delete">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="px-6 py-12 text-center">
                                    <div class="flex flex-col items-center space-y-4">
                                        <i data-lucide="users" class="w-16 h-16 text-gray-300"></i>
                                        <div>
                                            <h3 class="text-lg font-semibold text-gray-500">No users found</h3>
                                            <p class="text-gray-400">Try adjusting your filters or create a new user</p>
                                        </div>
                                        <a asp-page="./Create" class="btn-primary px-6 py-2 rounded-lg text-sm">
                                            <i data-lucide="user-plus" class="w-4 h-4 inline mr-2"></i>Create User
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Users != null && Model.Users.Any())
        {
            <div class="mt-6 flex justify-between items-center text-sm text-gray-600">
                <span>Showing @Model.Users.Count users</span>
                <div class="flex space-x-2">
                    <span>Items per page:</span>
                    <select class="border border-gray-300 rounded px-2 py-1 text-sm">
                        <option>10</option>
                        <option>25</option>
                        <option>50</option>
                    </select>
                </div>
            </div>
        }
    </div>
</div>

<script>
    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }

        async function exportUserCSV() {
        try {
            const exportBtn = event.target.closest('button');
            const originalText = exportBtn.innerHTML;
            exportBtn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 inline mr-2 animate-spin"></i>Exporting...';
            exportBtn.disabled = true;

            const response = await fetch("http://localhost:5019/api/CSV/export", {
                method: "GET",
                headers: {
                    'Accept': 'text/csv',
                    'Content-Type': 'application/json',
                }
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const blob = await response.blob();

            const url = window.URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;

            const timestamp = new Date().toISOString().slice(0, 19).replace(/:/g, '-');
            link.download = `users_export_${timestamp}.csv`;

            document.body.appendChild(link);
            link.click();

            document.body.removeChild(link);
            window.URL.revokeObjectURL(url);


        } catch (error) {
            console.error('Export failed:', error);
            showNotification('Export failed. Please try again.', 'error');
        } finally {
            // Reset button state
            const exportBtn = event.target.closest('button');
            exportBtn.innerHTML = originalText;
            exportBtn.disabled = false;

            // Reinitialize Lucide icons
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        }
    }
</script>