@page
@model TMS.Pages.User.DeleteModel
@{
    ViewData["Title"] = "Delete User";
}
<div id="delete-user-view" class="content-view">
    <div class="slide-in">
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-3xl font-bold text-gray-800 mb-2">Delete User</h2>
                    <p class="text-gray-600">Confirm deletion of user account</p>
                </div>
                <a asp-page="./Index" class="px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-50 transition-colors">
                    <i data-lucide="arrow-left" class="w-4 h-4 inline mr-2"></i>
                    Back to Users
                </a>
            </div>
        </div>

        <div class="content-card p-6">
            <div class="text-center">
                <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i data-lucide="alert-triangle" class="w-10 h-10 text-red-600"></i>
                </div>
                
                <h3 class="text-xl font-semibold text-gray-800 mb-4">Are you sure you want to delete this user?</h3>
                
                @if (Model.UserModel != null)
                {
                    <div class="bg-gray-50 rounded-lg p-6 mb-6">
                        <div class="flex items-center space-x-4">
                            <div class="w-16 h-16 bg-gradient-to-r from-red-500 to-red-600 rounded-full flex items-center justify-center">
                                <span class="text-white font-bold text-xl">
                                    @Model.UserModel.FirstName?.FirstOrDefault()
                                </span>
                            </div>
                            <div class="text-left">
                                <h4 class="text-lg font-semibold text-gray-800">@Model.UserModel.FirstName @Model.UserModel.LastName</h4>
                                <p class="text-gray-600">@Model.UserModel.Email</p>
                                <p class="text-gray-500 text-sm">Role: @Model.UserModel.Role</p>
                                
                                <p class="text-gray-500 text-sm">Tasks: @Model.UserModel.TaskCount</p>
                                
                            </div>
                        </div>
                    </div>
                }

                <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                    <div class="flex items-start space-x-3">
                        <i data-lucide="alert-circle" class="w-5 h-5 text-red-600 mt-0.5"></i>
                        <div class="text-left">
                            <h4 class="font-medium text-red-800">Warning</h4>
                            <p class="text-red-700 text-sm mt-1">
                                This action cannot be undone. All user data, including assigned tasks, will be permanently deleted.
                            </p>
                        </div>
                    </div>
                </div>

                <form method="post" class="space-y-4">
                    <div asp-validation-summary="All" class="text-red-600 text-sm"></div>
                    
                    <div class="flex items-center justify-center space-x-4">
                        <a asp-page="./Index" class="px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg transition-colors">
                            Cancel
                        </a>
                        <button type="submit" class="px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium transition-colors">
                            <i data-lucide="trash-2" class="w-4 h-4 inline mr-2"></i>
                            Delete User
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
