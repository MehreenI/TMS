@page
@model TMS.Pages.User.CreateModel
@{
    ViewData["Title"] = "Create User";
}
<div id="create-user-view" class="content-view">
    <h1 class="text-3xl font-bold text-gray-800 mb-6">Create New User</h1>
    <div class="content-card p-6">
        <form method="post">
        <div class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-gray-700 text-sm font-medium mb-2">First Name *</label>
                    <input asp-for="UserModel.FirstName" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200" placeholder="Enter first name">
                    <span asp-validation-for="UserModel.FirstName" class="text-red-600 text-sm"></span>
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-medium mb-2">Last Name *</label>
                    <input asp-for="UserModel.LastName" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200" placeholder="Enter last name">
                    <span asp-validation-for="UserModel.LastName" class="text-red-600 text-sm"></span>
                </div>
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-2">Email Address *</label>
                <input asp-for="UserModel.Email" type="email" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200" placeholder="Enter email address">
                <span asp-validation-for="UserModel.Email" class="text-red-600 text-sm"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-gray-700 text-sm font-medium mb-2">Phone Number</label>
                    <input asp-for="UserModel.PhoneNumber" type="tel" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200" placeholder="Enter phone number">
                    <span asp-validation-for="UserModel.PhoneNumber" class="text-red-600 text-sm"></span>
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-medium mb-2">Role *</label>
                    <select asp-for="UserModel.Role" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200">
                        <option value="">Select role...</option>
                        <option value="User">User</option>
                        <option value="Admin">Admin</option>
                    </select>
                    <span asp-validation-for="UserModel.Role" class="text-red-600 text-sm"></span>
                </div>
            </div>
            
            <div class="flex space-x-4">
                <button type="submit"
                        class="btn-primary">
                    <i data-lucide="user-plus" class="w-4 h-4 inline mr-2"></i>
                    Create User
                </button>
                <button asp-page="./Index"
                        class="px-6 py-2 border border-gray-300 rounded-md hover:bg-gray-50 transition-colors">
                    Cancel
                </button>
            </div>
        </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize Lucide icons
            lucide.createIcons();
        });
    </script>
}
