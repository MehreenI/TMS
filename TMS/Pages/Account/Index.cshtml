@page
@model TMS.Pages.Account.IndexModel
@{
    ViewData["Title"] = "My Account";
}

<div id="profile-settings" class="content-view">
    <div class="slide-in">
        <div class="mb-8">
            <h2 class="text-3xl font-bold text-gray-800 mb-2">Profile Settings</h2>
            <p class="text-gray-600">Manage your personal information and account preferences</p>
        </div>

        

            <!-- Settings Content -->
            <div class="lg:col-span-3 space-y-8">
                <!-- Personal Information -->
                <div id="personal-info" class="profile-section">
                    <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-xl font-semibold text-gray-800">Personal Information</h3>
                            <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-medium">Verified</span>
                        </div>

                        <!-- Profile Photo Section -->
                        <div class="flex items-center space-x-6 mb-8 p-6 bg-gray-50 rounded-lg border border-gray-200">
                            <div class="w-24 h-24 bg-gradient-to-r from-red-500 to-red-600 rounded-full flex items-center justify-center">
                                <span class="text-white font-bold text-3xl">
                                    @Model.CurrentUser?.FirstName?.FirstOrDefault()
                                </span>
                            </div>
                            <div class="flex-1">
                                <h4 class="text-gray-800 font-semibold mb-2">Profile Photo</h4>
                                <p class="text-gray-600 text-sm mb-4">Upload a professional photo for your profile</p>
                                
                            </div>
                        </div>

                        <!-- Profile Form -->
                        <form method="post" asp-antiforgery="true" class="space-y-6">
                            <div asp-validation-summary="All" class="text-red-600 text-sm"></div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <input type="hidden" asp-for="UserProfile.Id" />
                                <input type="hidden" asp-for="UserProfile.Role" />
                                <div>
                                    <label class="block text-gray-700 text-sm font-medium mb-2">First Name *</label>
                                    <input asp-for="UserProfile.FirstName" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200">
                                    <span asp-validation-for="UserProfile.FirstName" class="text-red-600 text-sm"></span>
                                </div>
                                <div>
                                    <label class="block text-gray-700 text-sm font-medium mb-2">Last Name *</label>
                                    <input asp-for="UserProfile.LastName" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200">
                                    <span asp-validation-for="UserProfile.LastName" class="text-red-600 text-sm"></span>
                                </div>
                            </div>

                            <div>
                                <label class="block text-gray-700 text-sm font-medium mb-2">Email Address *</label>
                                <input asp-for="UserProfile.Email" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200">
                                <span asp-validation-for="UserProfile.Email" class="text-red-600 text-sm"></span>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-gray-700 text-sm font-medium mb-2">Phone Number</label>
                                    <input asp-for="UserProfile.PhoneNumber" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200">
                                    <span asp-validation-for="UserProfile.PhoneNumber" class="text-red-600 text-sm"></span>
                                </div>
                            <div>
                                <label class="block text-gray-700 text-sm font-medium mb-2">New Password</label>
                                <input type="password" asp-for="UserProfile.Password" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200">
                            </div>
                            </div>

                           

                            <div class="flex items-center justify-end space-x-4">
                                <button type="button" class="px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg transition-colors">
                                    Cancel
                                </button>
                                <button type="submit" class="px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium transition-colors">
                                    Save Changes
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

