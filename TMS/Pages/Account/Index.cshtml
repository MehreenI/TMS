<script>
    function showProfileSection(sectionId) {
        // Hide all profile sections
        document.querySelectorAll('.profile-section').forEach(section => {
            section.classList.add('hidden');
        });

        // Remove active class from all profile nav items
        document.querySelectorAll('.profile-nav-item').forEach(item => {
            item.classList.remove('active', 'bg-red-50', 'text-red-600', 'border-red-200');
            item.classList.add('text-gray-700');
        });

        // Show selected section
        document.getElementById(sectionId).classList.remove('hidden');

        // Add active class to clicked nav item
        const clickedItem = event.target.closest('.profile-nav-item');
        clickedItem.classList.add('active', 'bg-red-50', 'text-red-600', 'border-red-200');
        clickedItem.classList.remove('text-gray-700');
    }
</script>