@page
@model TMS.Pages.Dashboard.ReportModel
<div id="reports-view" class="content-view">
    <h1 class="text-3xl font-bold text-gray-800 mb-6">Reports Dashboard</h1>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="content-card p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Monthly Performance Report</h3>
            <div class="space-y-3">
                <div class="flex justify-between">
                    <span class="text-gray-600">Total Projects</span>
                    <span class="font-semibold text-gray-800">45</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-600">Completed Tasks</span>
                    <span class="font-semibold text-gray-800">892</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-600">Team Efficiency</span>
                    <span class="font-semibold text-green-600">94%</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-600">Average Response Time</span>
                    <span class="font-semibold text-gray-800">2.4 hours</span>
                </div>
            </div>
            <button class="btn-primary w-full mt-4">
                <i data-lucide="download" class="w-4 h-4 inline mr-2"></i>
                Download Report
            </button>
        </div>
        <div class="content-card p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Quick Report Generator</h3>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Report Type</label>
                    <select class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500">
                        <option>Performance Summary</option>
                        <option>User Activity</option>
                        <option>Project Status</option>
                        <option>Team Productivity</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Date Range</label>
                    <select class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500">
                        <option>Last 7 days</option>
                        <option>Last 30 days</option>
                        <option>Last 90 days</option>
                        <option>Custom Range</option>
                    </select>
                </div>
                <button class="btn-primary w-full">Generate Report</button>
            </div>
        </div>
    </div>
</div>