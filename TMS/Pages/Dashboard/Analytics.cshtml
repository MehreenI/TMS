@page
@model TMS.Pages.Dashboard.AnalyticsModel
<div id="analytics-view" class="content-view">
    <div class="slide-in">
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-3xl font-bold text-gray-800 mb-2">Analytics Dashboard</h2>
                    <p class="text-gray-600">Comprehensive insights into system performance and user behavior</p>
                </div>
                <div class="flex items-center space-x-3">
                    <select class="px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:border-red-500">
                        <option>Last 7 days</option>
                        <option>Last 30 days</option>
                        <option>Last 90 days</option>
                        <option>Last 12 months</option>
                    </select>
                    <button class="btn-primary px-4 py-2 rounded-lg text-sm font-medium">
                        <i data-lucide="download" class="w-4 h-4 inline mr-2"></i>Export Report
                    </button>
                </div>
            </div>
        </div>

        <!-- Analytics Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <!-- User Activity Chart -->
            <div class="lg:col-span-2 content-card p-6">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-xl font-semibold text-gray-800">User Activity Trends</h3>
                    <div class="flex space-x-2 text-sm">
                        <button class="px-3 py-1 bg-red-600 text-white rounded">Active Users</button>
                        <button class="px-3 py-1 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded">New Registrations</button>
                    </div>
                </div>
                <div class="h-80">
                    <canvas id="userActivityChart"></canvas>
                </div>
            </div>

            <!-- Key Metrics -->
            <div class="space-y-6">
                <div class="content-card p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="text-lg font-semibold text-gray-800">Engagement Rate</h4>
                        <div class="text-2xl font-bold text-green-600">78.5%</div>
                    </div>
                    <div class="space-y-3">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">Daily Active Users</span>
                            <span class="text-gray-800 font-medium">845</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">Session Duration</span>
                            <span class="text-gray-800 font-medium">12m 34s</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">Bounce Rate</span>
                            <span class="text-gray-800 font-medium">21.5%</span>
                        </div>
                    </div>
                </div>

                <div class="content-card p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="text-lg font-semibold text-gray-800">Task Completion</h4>
                        <div class="text-2xl font-bold text-blue-600">92%</div>
                    </div>
                    <div class="relative pt-1">
                        <div class="flex mb-2 items-center justify-between">
                            <div>
                                <span class="text-xs font-semibold inline-block py-1 px-2 uppercase rounded-full text-blue-600 bg-blue-100">
                                    Progress
                                </span>
                            </div>
                            <div class="text-right">
                                <span class="text-xs font-semibold inline-block text-blue-600">
                                    92%
                                </span>
                            </div>
                        </div>
                        <div class="overflow-hidden h-2 mb-4 text-xs flex rounded bg-gray-200">
                            <div style="width:92%" class="shadow-none flex flex-col text-center whitespace-nowrap text-white justify-center bg-blue-500"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Performance Metrics -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="content-card p-6 hover:transform hover:translateY(-2px) transition-all duration-300">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">Total Tasks</p>
                        <p class="text-2xl font-bold text-gray-800">3,247</p>
                        <p class="text-green-600 text-sm flex items-center mt-1">
                            <i data-lucide="trending-up" class="w-3 h-3 mr-1"></i>
                            +12% from last month
                        </p>
                    </div>
                    <div class="p-3 bg-purple-600 rounded-lg">
                        <i data-lucide="clipboard-list" class="w-6 h-6 text-white"></i>
                    </div>
                </div>
            </div>

            <div class="content-card p-6 hover:transform hover:translateY(-2px) transition-all duration-300">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">Avg. Response Time</p>
                        <p class="text-2xl font-bold text-gray-800">2.4h</p>
                        <p class="text-green-600 text-sm flex items-center mt-1">
                            <i data-lucide="trending-down" class="w-3 h-3 mr-1"></i>
                            -8% faster
                        </p>
                    </div>
                    <div class="p-3 bg-blue-600 rounded-lg">
                        <i data-lucide="clock" class="w-6 h-6 text-white"></i>
                    </div>
                </div>
            </div>

            <div class="content-card p-6 hover:transform hover:translateY(-2px) transition-all duration-300">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">Team Productivity</p>
                        <p class="text-2xl font-bold text-gray-800">87%</p>
                        <p class="text-green-600 text-sm flex items-center mt-1">
                            <i data-lucide="trending-up" class="w-3 h-3 mr-1"></i>
                            +5% efficiency
                        </p>
                    </div>
                    <div class="p-3 bg-green-600 rounded-lg">
                        <i data-lucide="trending-up" class="w-6 h-6 text-white"></i>
                    </div>
                </div>
            </div>

            <div class="content-card p-6 hover:transform hover:translateY(-2px) transition-all duration-300">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">Error Rate</p>
                        <p class="text-2xl font-bold text-gray-800">0.3%</p>
                        <p class="text-red-600 text-sm flex items-center mt-1">
                            <i data-lucide="trending-up" class="w-3 h-3 mr-1"></i>
                            +0.1% from last week
                        </p>
                    </div>
                    <div class="p-3 bg-red-600 rounded-lg">
                        <i data-lucide="alert-triangle" class="w-6 h-6 text-white"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Device Analytics -->
        <div class="content-card p-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-6">Device Analytics</h3>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <div class="h-64">
                    <canvas id="deviceChart"></canvas>
                </div>
                <div class="flex flex-col justify-center">
                    <div class="space-y-4">
                        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg border">
                            <div class="flex items-center space-x-3">
                                <div class="w-4 h-4 bg-blue-500 rounded-full"></div>
                                <span class="text-gray-800">Desktop</span>
                            </div>
                            <span class="text-gray-800 font-semibold">58%</span>
                        </div>
                        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg border">
                            <div class="flex items-center space-x-3">
                                <div class="w-4 h-4 bg-green-500 rounded-full"></div>
                                <span class="text-gray-800">Mobile</span>
                            </div>
                            <span class="text-gray-800 font-semibold">32%</span>
                        </div>
                        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg border">
                            <div class="flex items-center space-x-3">
                                <div class="w-4 h-4 bg-purple-500 rounded-full"></div>
                                <span class="text-gray-800">Tablet</span>
                            </div>
                            <span class="text-gray-800 font-semibold">10%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>