@page
@model TMS.Pages.Employee.ViewTaskModel
@{
    ViewData["Title"] = "View Task";
}
<div id="view-task-view" class="content-view">
    <div class="slide-in">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Task Details</h1>
            <div class="flex space-x-3">

                <a asp-page="./Employee/MyTask" class="px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-50 transition-colors">
                    <i data-lucide="arrow-left" class="w-4 h-4 inline mr-2"></i>
                    Back to Tasks
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Task Overview Card -->
            <div class="content-card p-6">
                <div class="text-center mb-6">
                    <div id="taskStatusIcon" class="w-16 h-16 bg-gradient-to-r from-orange-500 to-red-600 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i data-lucide="play-circle" class="w-8 h-8 text-white"></i>
                    </div>
                    <h3 id="taskTitle" class="text-xl font-bold text-gray-800 mb-2">@Model.Task.Title</h3>
                    <div id="taskStatus" class="inline-flex items-center px-3 py-1 bg-orange-100 text-orange-800 rounded-full text-sm font-medium mb-4">
                        @Model.Task.Status
                    </div>
                </div>

                <!-- Status Change Form -->
                <div class="mb-6 p-4 bg-gray-50 rounded-lg">
                    <h5 class="text-sm font-semibold text-gray-700 mb-3">Update Status</h5>
                    <form method="post" asp-page-handler="UpdateStatus">
                        <input type="hidden" asp-for="Task.Id" />
                        <div class="flex flex-col space-y-3">
                            <select name="NewStatus" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
                                <option value="ToDo" selected="@(Model.Task.Status == "ToDo")">To Do</option>
                                <option value="InProgress" selected="@(Model.Task.Status == "InProgress")">In Progress</option>
                                <option value="Done" selected="@(Model.Task.Status == "Done")">Done</option>
                            </select>
                            <button type="submit" class="w-full px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors text-sm font-medium">
                                <i data-lucide="check" class="w-4 h-4 inline mr-2"></i>
                                Update Status
                            </button>
                        </div>
                    </form>
                </div>

                <div class="pt-6 border-t border-gray-200">
                    <h4 class="font-semibold text-gray-800 mb-3">Quick Info</h4>
                    <div class="space-y-2">
                        <div class="flex justify-between">
                            <span class="text-gray-600">Priority</span>
                            <span class="px-2 py-1 bg-red-600 text-white rounded text-sm">@Model.Task.Priority</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Due Date</span>
                            <span class="font-semibold text-gray-800">@Model.Task.Deadline?.ToString("MM/dd/yyyy")</span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Task Information -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Task Description -->
                <div class="content-card p-6">
                    <h4 class="text-lg font-semibold text-gray-800 mb-4">Description</h4>
                    <p class="text-gray-700 leading-relaxed">
                        @Model.Task.Description
                    </p>
                </div>

                <!-- Assignment Details -->
                <div class="content-card p-6">
                    <h4 class="text-lg font-semibold text-gray-800 mb-4">Assignment Details</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-600 mb-1">Assigned To</label>
                            <div class="flex items-center space-x-3">
                                <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full flex items-center justify-center">
                                    <span class="text-white font-semibold text-sm">JD</span>
                                </div>
                                <div>
                                    <p class="text-gray-800 font-medium">@Model.Task.AssignedUserName</p>
                                </div>
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-600 mb-1">Project</label>
                            <p class="text-gray-800 font-medium">@Model.Task.Title</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-600 mb-1">Created Date</label>
                            <p class="text-gray-800 font-medium">@Model.Task.CreatedDate</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="fixed top-4 right-4 z-50">
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded shadow-lg">
            <i data-lucide="check-circle" class="w-4 h-4 inline mr-2"></i>
            @TempData["SuccessMessage"]
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="fixed top-4 right-4 z-50">
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded shadow-lg">
            <i data-lucide="x-circle" class="w-4 h-4 inline mr-2"></i>
            @TempData["ErrorMessage"]
        </div>
    </div>
}

<script>
    setTimeout(function() {
        const messages = document.querySelectorAll('.fixed.top-4.right-4');
        messages.forEach(function(message) {
            message.style.opacity = '0';
            setTimeout(function() {
                message.remove();
            }, 300);
        });
    }, 3000);

    document.addEventListener('DOMContentLoaded', function() {
        const status = '@Model.Task.Status';
        const statusIcon = document.getElementById('taskStatusIcon');
        const statusText = document.getElementById('taskStatus');
        const icon = statusIcon.querySelector('i');

        switch(status) {
            case 'ToDo':
                statusIcon.className = 'w-16 h-16 bg-gradient-to-r from-gray-500 to-gray-600 rounded-full flex items-center justify-center mx-auto mb-4';
                statusText.className = 'inline-flex items-center px-3 py-1 bg-gray-100 text-gray-800 rounded-full text-sm font-medium mb-4';
                icon.setAttribute('data-lucide', 'circle');
                break;
            case 'InProgress':
                statusIcon.className = 'w-16 h-16 bg-gradient-to-r from-orange-500 to-red-600 rounded-full flex items-center justify-center mx-auto mb-4';
                statusText.className = 'inline-flex items-center px-3 py-1 bg-orange-100 text-orange-800 rounded-full text-sm font-medium mb-4';
                icon.setAttribute('data-lucide', 'play-circle');
                break;
            case 'Done':
                statusIcon.className = 'w-16 h-16 bg-gradient-to-r from-green-500 to-green-600 rounded-full flex items-center justify-center mx-auto mb-4';
                statusText.className = 'inline-flex items-center px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-medium mb-4';
                icon.setAttribute('data-lucide', 'check-circle');
                break;
        }

        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
    });
</script>