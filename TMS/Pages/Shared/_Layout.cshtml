@{
    var token = Context.Session.GetString("JWTToken");
    var isAuthenticated = !string.IsNullOrWhiteSpace(token);
    var fullName = Context.Session.GetString("FullName");
    var userRole = Context.Session.GetString("UserRole");

    var isAdmin = (userRole == "Admin");
    TempData["isAdmin"] = isAdmin;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TaskFlow Pro - Advanced Admin Panel</title>

    <!-- Favicon and Icons -->
    <link rel="icon" type="image/x-icon" href="~/images/favicon.svg">
    <link rel="shortcut icon" type="image/x-icon" href="~/images/favicon.svg">
    <meta name="msapplication-TileColor" value="#dc2626">
    <meta name="msapplication-TileImage" content="~/images/ms-icon-144x144.png">
    <meta name="theme-color" content="#dc2626">

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="~/js/ckeditor/classic/ckeditor.js"></script>

</head>

<body class="bg-gray-50 text-gray-800 min-h-screen loading">
    <!-- Loading Screen -->
    <div id="loader" class="loader-overlay">
        <div class="loader-container">
            <div class="loader-logo">
                <span>T</span>
            </div>
            <h1 class="loader-title">Taskify</h1>
            <div class="loader-spinner">
                <div class="spinner"></div>
            </div>
            <div class="loader-progress">
                <div class="loader-progress-bar"></div>
            </div>
            <p class="loader-text">Loading your workspace...</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Animated Header -->
        <header class="glass-card border-b border-gray-200 sticky top-0 z-50">
            <div class="px-6 py-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-4">
                        <button onclick="toggleSidebar()" class="p-2 hover:bg-red-50 rounded-lg transition-colors">
                            <i data-lucide="menu" class="w-5 h-5 text-gray-600"></i>
                        </button>
                        <div class="flex items-center space-x-3">
                            <div class="animate-float">
                                <div class="w-8 h-8 bg-gradient-to-r from-red-500 to-red-600 rounded-lg flex items-center justify-center">
                                    <span class="text-white font-bold text-lg">T</span>
                                </div>
                            </div>
                            <div>
                                <h1 class="text-xl font-bold bg-gradient-to-r from-red-600 to-red-800 bg-clip-text text-transparent">
                                    Taskify
                                </h1>
                                <p class="text-xs text-gray-500">@(isAdmin ? "Admin Panel" : "User Dashboard")</p>
                            </div>
                        </div>
                    </div>

                    
                </div>
            </div>
        </header>

        <!-- Main Container -->
        <div class="flex min-h-screen">
            <nav id="sidebar" class="w-72 glass-card border-r border-gray-200 min-h-screen custom-scrollbar overflow-y-auto">
                <div class="p-6">
                    <div class="space-y-8">
                        <!-- Dashboard Section -->
                        <div>
                            <h3 class="text-xs uppercase tracking-wider text-gray-500 font-semibold mb-4 px-3">Dashboard</h3>
                            <div class="space-y-1">
                                
                                    <a asp-area="" asp-page="/Home/Index" class="nav-item active flex items-center space-x-3 px-3 py-3 rounded-lg transition-all">
                                        <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                                        <span class="nav-text font-medium">Overview</span>
                                    </a>
                                
                            </div>
                        </div>

                        <!-- User Management -->
                        @if (isAdmin)
                        {
                            <div>
                                <h3 class="text-xs uppercase tracking-wider text-gray-500 font-semibold mb-4 px-3">User Management</h3>
                                <div class="space-y-1">

                                    <a asp-area="" asp-page="/User/Index" class="nav-item flex items-center space-x-3 px-3 py-3 rounded-lg hover:bg-red-50 transition-all text-gray-700">
                                        <i data-lucide="users" class="w-5 h-5"></i>
                                        <span class="nav-text">All Users</span>
                                    </a>
                                    <a asp-area="" asp-page="/User/Create" class="nav-item flex items-center space-x-3 px-3 py-3 rounded-lg hover:bg-red-50 transition-all text-gray-700">
                                        <i data-lucide="user-plus" class="w-5 h-5"></i>
                                        <span class="nav-text">Create User</span>
                                    </a>
                                </div>
                            </div>
                        }

                        <!-- Task & Project Management -->
                        <div>
                            <h3 class="text-xs uppercase tracking-wider text-gray-500 font-semibold mb-4 px-3">Task & Projects</h3>
                            <div class="space-y-1">
                                @if (isAdmin)
                                {
                                    <a asp-area="" asp-page="/Task/Index" class="nav-item flex items-center space-x-3 px-3 py-3 rounded-lg hover:bg-red-50 transition-all text-gray-700">
                                        <i data-lucide="clipboard-list" class="w-5 h-5"></i>
                                        <span class="nav-text">All Tasks</span>
                                    </a>

                                    <a asp-area="" asp-page="/Task/Create" class="nav-item flex items-center space-x-3 px-3 py-3 rounded-lg hover:bg-red-50 transition-all text-gray-700">
                                        <i data-lucide="plus" class="w-5 h-5"></i>
                                        <span class="nav-text">Create and Assign Task</span>
                                    </a>
                                }
                                else
                                {
                                    <a asp-area="" asp-page="/Employee/MyTask" class="nav-item flex items-center space-x-3 px-3 py-3 rounded-lg hover:bg-red-50 transition-all text-gray-700">
                                        <i data-lucide="clipboard-list" class="w-5 h-5"></i>
                                        <span class="nav-text">My Task</span>
                                    </a>
                                }
                            </div>
                        </div>


                        <!-- System -->
                        <div>
                            <h3 class="text-xs uppercase tracking-wider text-gray-500 font-semibold mb-4 px-3">System</h3>
                            <div class="space-y-1">
                                <a asp-area="" asp-page="/Account/Index" class="nav-item flex items-center space-x-3 px-3 py-3 rounded-lg hover:bg-red-50 transition-all text-gray-700">
                                    <i data-lucide="user-circle" class="w-5 h-5"></i>
                                    <span class="nav-text">Profile Settings</span>
                                </a>
                                <a asp-page="/Home/Logout" class="nav-item flex items-center space-x-3 px-3 py-3 rounded-lg hover:bg-red-50 transition-all text-gray-700">
                                    <i data-lucide="log-out" class="w-5 h-5"></i>
                                    <span class="nav-text">Log Out</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>

            <main class="flex-1 p-8 custom-scrollbar overflow-y-auto bg-gray-50">
                <div id="main-content">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="fixed top-4 right-4 z-50">
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded shadow-lg">
                <i data-lucide="check-circle" class="w-4 h-4 inline mr-2"></i>
                @TempData["SuccessMessage"]
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="fixed top-4 right-4 z-50">
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded shadow-lg">
                <i data-lucide="x-circle" class="w-4 h-4 inline mr-2"></i>
                @TempData["ErrorMessage"]
            </div>
        </div>
    }

    <script>
        window.addEventListener('load', function() {
            setTimeout(function() {
                const loader = document.getElementById('loader');
                const body = document.body;
                loader.classList.add('hidden');
                body.classList.remove('loading');
                setTimeout(function() {
                    if (loader.parentNode) {
                        loader.parentNode.removeChild(loader);
                    }
                }, 500);
            }, 2000);
        });
        document.addEventListener('DOMContentLoaded', function() { lucide.createIcons(); });
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/lucide/lucide.js"> </script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>