@page
@model TMS.Pages.Task.CreateModel
<div id="create-task-view" class="content-view">
    <div class="slide-in">
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-3xl font-bold text-gray-800 mb-2">Create New Task</h2>
                    <p class="text-gray-600">Create and assign tasks to team members with detailed instructions</p>
                </div>
                <div class="flex items-center space-x-3">
                    <button type="reset" class="px-4 py-2 bg-white hover:bg-gray-50 text-gray-700 rounded-lg transition-colors border border-gray-300">
                        <i data-lucide="refresh-cw" class="w-4 h-4 inline mr-2"></i>Reset Form
                    </button>
                </div>
            </div>
        </div>

        <!-- Task Assignment Form -->
        <div class="space-y-8">
            <!-- Task Details -->
            <form method="post" asp-antiforgery="true">
                <div asp-validation-summary="All" class="text-red-600 text-sm mb-4"></div>
                
                <div class="content-card p-6">
                    <div class="flex items-center space-x-3 mb-6">
                        <div class="p-2 bg-blue-600 rounded-lg">
                            <i data-lucide="clipboard-list" class="w-5 h-5 text-white"></i>
                        </div>
                        <h3 class="text-xl font-semibold text-gray-800">Task Details</h3>
                    </div>
                    

                    <div class="space-y-6">
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2">Task Title *</label>
                            <input asp-for="Task.Title" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 placeholder-gray-400 focus:outline-none focus:border-red-500" placeholder="Enter a clear and descriptive task title" required>
                            <span asp-validation-for="Task.Title" class="text-red-600 text-sm"></span>
                        </div>

                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2">Task Description *</label>
                            <textarea asp-for="Task.Description" rows="5" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 placeholder-gray-400 focus:outline-none focus:border-red-500" placeholder="Provide detailed instructions, requirements, and acceptance criteria" required></textarea>
                            <span asp-validation-for="Task.Description" class="text-red-600 text-sm"></span>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div>
                                <label class="block text-gray-700 text-sm font-medium mb-2">Priority *</label>
                                <select asp-for="Task.Priority" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500" required>
                                    <option value="">Select priority...</option>
                                    <option value="Low">🟢 Low Priority</option>
                                    <option value="Medium">🟡 Medium Priority</option>
                                    <option value="High">🟠 High Priority</option>
                                </select>
                                <span asp-validation-for="Task.Priority" class="text-red-600 text-sm"></span>
                            </div>

                            <div>
                                <label class="block text-gray-700 text-sm font-medium mb-2">Due Date *</label>
                                <input type="date" asp-for="Task.Deadline" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500" required>
                                <span asp-validation-for="Task.Deadline" class="text-red-600 text-sm"></span>
                            </div>

                            <div>
                                <label class="block text-gray-700 text-sm font-medium mb-2">Assigned User</label>
                                <select asp-for="Task.AssignedUserId" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-800 focus:outline-none focus:border-red-500">
                                    <option value="">Select user...</option>
                                    @if (Model.Users != null)
                                    {
                                        @foreach (var user in Model.Users)
                                        {
                                            <option value="@user.Id">@user.FirstName @user.LastName (@user.Email)</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="Task.AssignedUserId" class="text-red-600 text-sm"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center justify-end space-x-4">
                    <a asp-page="/Task/Index" class="px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg transition-colors">
                        <i data-lucide="x" class="w-5 h-5 inline mr-2"></i>Cancel
                    </a>
                   
                    <button type="submit" class="btn-primary px-6 py-3 rounded-lg font-medium">
                        <i data-lucide="send" class="w-5 h-5 inline mr-2"></i>Create Task
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
