{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ApiSettings": {
        "BaseUrl": "https://localhost:7001",
        "Timeout": 30
    },
    "Cors": {
        "AllowedOrigins": [ "https://localhost:5001", "https://localhost:5173" ]
    },
    "SessionTimeout": 30,
    "CookieSettings": {
        "SecurePolicy": "Always",
        "SameSite": "Strict"
    }
}
